# Cloudflare Turnstile — must pair with frontend VITE_TURNSTILE_SITE_KEY (same widget)
# Dev only: TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production (Render): use Secret Key from Cloudflare Turnstile widget (not 1x0000… test key)
# TURNSTILE_SECRET_KEY=

# Public frontend URL (password reset emails, admin invite links)
FRONTEND_URL=https://dbabygrill-frontend.vercel.app

# Email verification at sign-in (default off). Set true when Supabase Confirm email + SMTP are on.
# REQUIRE_EMAIL_VERIFICATION=false
