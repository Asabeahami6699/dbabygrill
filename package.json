{
  "name": "grill-ecommerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "date-fns": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "react-leaflet": "^5.0.0"
  }
}
