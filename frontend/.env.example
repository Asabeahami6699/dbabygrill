VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:5000/api
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: Stadia OSM Bright tiles (clearer roads than free OSM tiles)
# VITE_STADIA_API_KEY=

# Public site URL (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://dbabygrill.vercel.app

# Cloudflare Turnstile — "Verify you are human" on login & register
# Create widget: https://dash.cloudflare.com/?to=/:account/turnstile
# Add hostname: dbabygrill.vercel.app (+ localhost for dev)
#
# Dev test keys (always pass — Cloudflare docs):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Production: use your widget's Site Key
# VITE_TURNSTILE_SITE_KEY=your_site_key_here
