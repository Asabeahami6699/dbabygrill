VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:5000/api
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: Stadia OSM Bright tiles (clearer roads than free OSM tiles)
# VITE_STADIA_API_KEY=

# Public site URL (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://dbabygrill-frontend.vercel.app

# Cloudflare Turnstile — "Verify you are human" on login & register
# Create widget: https://dash.cloudflare.com/?to=/:account/turnstile
# Add hostname: dbabygrill-frontend.vercel.app (+ localhost for dev)
#
# Dev test keys (always pass — Cloudflare docs):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Production: use your widget's Site Key
# VITE_TURNSTILE_SITE_KEY=your_site_key_here

# Google Sign-In (Supabase Auth → Providers → Google)
# 1. Google Cloud Console: create OAuth client (Web), copy Client ID (*.apps.googleusercontent.com)
# 2. Supabase Dashboard → Authentication → Providers → Google: paste Client ID + Secret
# 3. Supabase → URL Configuration → Site URL + Redirect URLs:
#    https://dbabygrill-frontend.vercel.app
#    https://dbabygrill-frontend.vercel.app/auth/callback
#    https://dbabygrill-frontend.vercel.app/reset-password
#    https://dbabygrill-frontend.vercel.app/login
#    http://localhost:5173/auth/callback
#    http://localhost:5173/reset-password
#    http://localhost:5173/login
# 4. Google Cloud → Authorized redirect URIs (required by Google):
#    https://uxdjsculeaeiidugraua.supabase.co/auth/v1/callback

# Backend Render env: FRONTEND_URL=https://dbabygrill-frontend.vercel.app
